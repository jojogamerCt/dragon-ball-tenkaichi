{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": [
        "Sh4d0wJ0J0",
        "Claude"
    ],
    "contact": {
        "sources": "https://github.com/jojogamerCt/dragon-ball-tenkaichi"
    },
    "license": "${license}",
    "icon": "assets/${mod_id}/icon.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "com.dbtenkaichi.fabric.TenkaichiFabric"
        ],
        "client": [
            "com.dbtenkaichi.fabric.TenkaichiFabricClient"
        ]
    },
    "mixins": [
        "${mod_id}.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=${fabric_loader_version}",
        "fabric-api": "*",
        "minecraft": "~${minecraft_version}",
        "java": ">=${java_version}"
    }
}
